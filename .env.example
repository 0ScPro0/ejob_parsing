# ============================================================
# ejob-parsing: пример переменных окружения
# Скопируйте в .env:  copy .env.example .env  (Windows)
#                      cp .env.example .env   (Linux/macOS)
# ============================================================

# --- Общие настройки ---
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30            # таймаут HTTP-запроса, сек
RETRY_ATTEMPTS=3              # сколько раз повторить при 403/429/5xx
RETRY_WAIT_SECONDS=5          # базовая пауза между ретраями
REQUEST_DELAY_MIN=4           # случайная пауза между запросами, сек (мин)
REQUEST_DELAY_MAX=8           # случайная пауза между запросами, сек (макс)
ROTATE_USER_AGENT=false       # ротация User-Agent через fake-useragent

# --- Поиск вакансий (модуль 1) ---
# Списки можно писать через запятую или JSON-массивом:
#   SEARCH_LEVELS=middle,senior
#   SEARCH_TECHNOLOGIES=["python","go"]
SEARCH_LEVELS=middle,senior
SEARCH_EXPERIENCE=between3And6   # noExperience | between1And3 | between3And6 | moreThan6
SEARCH_DIRECTIONS=fullstack,web
SEARCH_TECHNOLOGIES=python,go,js,ai
MAX_PAGES=40                     # лимит пагинации hh.ru
# Сколько HTTP-клиентов работают одновременно (фаза 1: поисковые запросы,
# фаза 2: страницы вакансий). Ускорение ~N раз, но растёт частота запросов
# к hh.ru — риск бана (R-4). 1 = строго последовательно, как раньше.
PARSE_WORKERS=3
# Вакансия сохраняется, если в тексте есть хотя бы одно из этих слов
# (пусто = используются SEARCH_TECHNOLOGIES; запятая = список)
# VACANCY_MATCH_KEYWORDS=python,go,js,ai
# Негативные параметры: вакансия СКИПАЕТСЯ, если в её тексте есть любое
# из слов (например, не нужны QA/тестировщики). Регистр не важен.
# VACANCY_EXCLUDE_KEYWORDS=qa,тестировщик
# Требуемый формат работы: сохраняем только вакансии, где встречается хотя
# бы одно значение. Для «только удалёнки»:
VACANCY_WORK_FORMATS=удаленн,remote
# Пустое значение = без фильтра (офис + удалёнка).

# --- Ключевые слова (модуль 2) ---
MIN_KEYWORD_FREQ=5               # порог частоты термина (N=5 по ТЗ)
TOP_KEYWORDS=200                 # сколько терминов сохранить в keywords.txt
KEYWORD_NGRAM_MAX=3              # униграммы/биграммы/триграммы

# --- ИИ-аналитика вакансий (опционально) ---
# Сводка по собранным вакансиям со ссылками и примерами сопроводительных
# писем -> ai_analytics.txt. Требует OPENAI_API_KEY; без него пропускается,
# keywords.txt всё равно генерируется обычным частотным анализом.
AI_ANALYTICS_ENABLED=true
AI_VACANCIES_LIMIT=50            # сколько вакансий передать модели
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=               # для прокси/совместимых API
OPENAI_TIMEOUT=60
# Переопределение системного промпта (дефолтный — в src/ejob_parsing/ai.py).
# Многострочный текст можно записать через \n
# OPENAI_SYSTEM_PROMPT=Ты — помощник. Составь сводку...

# --- Резюме (модуль 3) ---
RESUME_TOP=1                     # сколько первых ключевых слов использовать
RESUME_HEADLESS=true             # headless-режим браузера

# --- Авторизация hh.ru ---
HH_LOGIN=your_email@example.com
HH_PASSWORD=your_password
HH_STORAGE_STATE=./storage_state.json

# --- Прокси (опционально, для резюме и при 403) ---
PROXY_URL=

# --- Пути вывода данных ---
VACANCIES_OUTPUT=./out/vacancies/vacancies.jsonl
MOST_CV_OUTPUT=./out/most_cv/most_cv.jsonl
KEYWORDS_OUTPUT=./out/keywords.txt
AI_ANALYTICS_OUTPUT=./out/ai_analytics.txt

# --- Селекторы hh.ru (R-7: правим здесь при изменении вёрстки) ---
# SELECTOR_RESUME_CARD=[data-qa='resume-serp__resume']
# SELECTOR_RESUME_LINK=a[data-qa='resume-serp__resume-title']